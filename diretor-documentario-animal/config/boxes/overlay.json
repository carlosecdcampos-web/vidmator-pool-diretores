    {
      "id": "Ovl16_MarcoTemporalProgressivo",
      "nome": "Marco Temporal Progressivo",
      "status": "oficial",
      "aprovado_operador_em": "2026-08-14",
      "module": "./overlays/MarcoTemporal",
      "export": "Ovl16_MarcoTemporalProgressivo",
      "quando": "ano passado ligado explicitamente ao presente ou ano futuro; linha temporal amarela avança da esquerda para a direita",
      "porque_usar": "materializar visualmente a continuidade ou o avanço do tempo sem interromper o take documental",
      "diretriz_editorial": {
        "usar_quando": [
          "um ano passado estiver ligado semanticamente ao presente, como algo que começou no passado e continua, permanece ou ainda vale hoje",
          "um ano futuro for citado como previsão, meta, projeção ou acontecimento por vir",
          "o ano estiver em numeral ou escrito por extenso em português, inglês, espanhol ou alemão"
        ],
        "nao_usar_quando": [
          "houver somente dia e mês, sem ano",
          "um ano passado for apenas uma menção histórica isolada; nesse caso usar a rota data_retroativa",
          "não existir relação temporal clara entre o ano citado e o presente ou o futuro"
        ],
        "como_usar": [
          "passado ligado ao presente: ano citado → ano corrente calculado no momento da produção",
          "ano futuro: ano corrente calculado no momento da produção → ano citado",
          "até 200 anos de intervalo, mostrar marcos por década; acima de 200 anos, mostrar marcos por século",
          "a linha progride obrigatoriamente da esquerda para a direita; início e fim recebem ponto, cor e destaque amarelos"
        ]
      },
      "roteamento": [
        {
          "intencao": "data_progressiva",
          "dominio": "overlay",
          "tom": null,
          "ordem_base": 0
        }
