      "peso_operador": 1,
      "uso_obrigatorio": true,
      "exibe": [
        "texto"
      ],
      "requer": {
        "todos": [
          "texto"
        ]
      },
      "requer_especial": null,
      "max_palavras": 4,
      "piso_s": 4.2,
      "contrato_timeline": {
        "tipo": "overlay_take_saida_sincrona",
        "dur_take_s": 5.5,
        "offset_elemento_s": 1.3,
        "dur_elemento_s": 4.2,
        "hold_inicial_s": 1.0,
        "avanco_s": 1.7,
        "hold_final_s": 1.5,
        "proibir_corte_interno": true,
        "proibir_transicao": true,
        "saida_mesmo_frame": true
      },
